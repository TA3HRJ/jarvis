# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizle doldurun.
# .env gitignore'dadır, gerçek anahtarlar/sırlar asla commit edilmemeli.

# Katman 4 (bulut LLM) — varsayılan sağlayıcı DeepSeek
DEEPSEEK_API_KEY=

# JARVIS_LLM_PROVIDER=claude yapılırsa bunun yerine ANTHROPIC_API_KEY okunur
# (Anthropic SDK'sı bunu örtük olarak ortam değişkeninden alır)
# ANTHROPIC_API_KEY=

# deepseek | claude (opsiyonel, varsayılan: deepseek)
# JARVIS_LLM_PROVIDER=deepseek

# Uzaktan dispatch API'si (Faz 6) — Tailscale mesh içindeki adresiniz
JARVIS_API_HOST=100.x.x.x
# JARVIS_API_PORT=8765

# /command endpoint'i için paylaşılan gizli token
JARVIS_API_TOKEN=

# ntfy.sh push bildirimleri için rastgele/tahmin edilemez konu adı
JARVIS_NTFY_TOPIC=

# opsiyonel: log seviyesi (varsayılan INFO), wake word debug skorları
# JARVIS_LOG_LEVEL=INFO
# JARVIS_DEBUG_WAKE=1
